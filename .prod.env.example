# npm start always selects production mode and loads this file.
# The server sits behind a reverse proxy on the same host, so it listens on
# loopback. Set HOST=0.0.0.0 only to expose it directly. Never commit secrets.
PORT=3000
HOST=127.0.0.1

# Required. Generate a long random value, for example: openssl rand -hex 32
SESSION_SECRET=

{
  "name": "pum",
  "version": "0.1.0",
  "description": "Universal React with server-side rendering and Node.js",
  "private": true,
  "license": "UNLICENSED",
  "homepage": "https://github.com/jetmirshatri/pum#readme",
  "repository": {
    "url": "https://github.com/jetmirshatri/pum.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/jetmirshatri/pum/issues"
  },
  "vitex": {
    "template": "vitex",
    "generatorVersion": "0.0.0",
    "features": [
      "demo"
    ]
  },
  "type": "module",
  "imports": {
    "#vitex": "./build/rsc/index.js"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "browserslist": {
    "production": [
      "> 0.5%",
      "last 2 versions",
      "not dead",
      "not kaios <= 3.1",
      "not op_mini all",
      "not samsung <= 19",
      "not and_uc <= 15.5",
      "not baidu <= 13"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "@remix-run/node-fetch-server": "^1.0.0",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "express-static-gzip": "^3.0.2",
    "isbot": "^5.2.2",
    "morgan": "^1.12.1",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router": "^8.5.1",
    "react-server-dom-webpack": "^19.3.1"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "oxc-transform-react": "^0.156.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "postcss": "^8.5.32",
    "postcss-preset-env": "^11.6.2",
    "stylelint": "^18.0.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-order": "^8.1.3",
    "tsrs": "^0.23.0-ts7.1.0-beta",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.prod.env server.js --mode=production",
    "dev": "node --env-file-if-exists=.dev.env server.js --mode=development",
    "build": "vite build && node scripts/compress-assets.mjs",
    "typecheck": "tsrs",
    "test": "vitest run --passWithNoTests && node --test \"scripts/check-*.mjs\"",
    "test:unit": "vitest",
    "lint": "oxlint && oxfmt --check && stylelint \"app/**/*.module.css\" \"app/**/*.css\" && tsrs",
    "lint:fix": "oxlint --fix && oxfmt && stylelint \"app/**/*.module.css\" \"app/**/*.css\" --fix && tsrs"
  },
  "author": "Jetmir Shatri <hello@jetmirshatri.dev>"
}
